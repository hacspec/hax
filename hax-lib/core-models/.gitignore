# hax's per-crate staging output. `make fstar` copies the F* out of here
# into ../proof-libs/fstar/core, which is where the committed library lives.
**/proofs/fstar/extraction/
**/proofs/lean/extraction/

# Aeneas-extracted output for the two test crates (regenerated each
# build). The hand-written `Assumptions/` stubs of `rust_lean_equiv_test`
# and the entry-point modules (`ClientTest.lean`, `RustLeanTests.lean`)
# stay tracked.
tests/client_test/proofs/lean/ClientTest/**
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/Extraction/
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/Extraction.lean
# Generated by `gen_lean_tests.py`; `skipped.log` is `check-skipped` output.
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/LeanTests.lean
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/SkippedTests.lean
tests/rust_lean_equiv_test/skipped.log
# Lake's resolver state is regenerated from `lakefile.toml`.
tests/client_test/proofs/lean/lake-manifest.json
tests/rust_lean_equiv_test/source/proofs/lean/lake-manifest.json
# hax generates a `.gitignore` inside each Lean package on every run.
tests/client_test/proofs/lean/.gitignore
tests/rust_lean_equiv_test/source/proofs/lean/.gitignore

