letfun new_tests__legacy__guards__lib__if_let_guard(x : Option) =
       rust_primitives__hax__failure(
         "[hax::opaque] Explicit rejection by a phase in the Hax engine: a node of kind [Match_guard] have been found in the AST",
         ""
       ).

letfun new_tests__legacy__guards__lib__equivalent(x : Option) =
       let None() = x in 0
       else let Some(nat_to_bitstring(y)) = let Some(nat_to_bitstring(v)) = x in let y = v in Some(
         nat_to_bitstring(y)
       )
       else None()
       else None() in y
       else let None() = let Some(nat_to_bitstring(v)) = x in let y = v in Some(
         nat_to_bitstring(y)
       )
       else None()
       else None() in let Some(
         nat_to_bitstring(core_models__result__Result_Err(y))
       ) = x in y
       else 1.

letfun new_tests__legacy__guards__lib__multiple_guards(x : Option) =
       rust_primitives__hax__failure(
         "[hax::opaque] Explicit rejection by a phase in the Hax engine: a node of kind [Match_guard] have been found in the AST",
         ""
       ).

letfun new_tests__legacy__guards__lib__if_guard(x : Option) =
       rust_primitives__hax__failure(
         "[hax::opaque] Explicit rejection by a phase in the Hax engine: a node of kind [Match_guard] have been found in the AST",
